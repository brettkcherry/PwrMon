<Window x:Class="PwrMon.Views.MiniGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PwrMon Mini"
        Width="300" Height="150" MinWidth="150" MinHeight="90"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{DynamicResource TextFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- hit-testable but invisible: the grip is felt, not seen -->
        <ControlTemplate x:Key="InvisibleThumb" TargetType="Thumb">
            <Border Background="Transparent"/>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
    <Border x:Name="RootBorder" CornerRadius="12" Background="#EE12151B" BorderBrush="#333B49" BorderThickness="1"
            Padding="12,8">
        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened">
                <MenuItem Header="Open dashboard" Click="OpenDashboard_Click" FontWeight="Bold"/>
                <Separator/>
                <MenuItem x:Name="MenuOpacity100" Header="Opacity 100%" IsCheckable="True" Click="Opacity_Click" Tag="100"/>
                <MenuItem x:Name="MenuOpacity85" Header="Opacity 85%" IsCheckable="True" Click="Opacity_Click" Tag="85"/>
                <MenuItem x:Name="MenuOpacity70" Header="Opacity 70%" IsCheckable="True" Click="Opacity_Click" Tag="70"/>
                <MenuItem x:Name="MenuOpacity50" Header="Opacity 50%" IsCheckable="True" Click="Opacity_Click" Tag="50"/>
                <Separator/>
                <MenuItem x:Name="MenuWin60" Header="Show last 60 s" IsCheckable="True" Click="WindowSecs_Click" Tag="60"/>
                <MenuItem x:Name="MenuWin120" Header="Show last 2 min" IsCheckable="True" Click="WindowSecs_Click" Tag="120"/>
                <MenuItem x:Name="MenuWin300" Header="Show last 5 min" IsCheckable="True" Click="WindowSecs_Click" Tag="300"/>
                <MenuItem x:Name="MenuWin900" Header="Show last 15 min" IsCheckable="True" Click="WindowSecs_Click" Tag="900"/>
                <MenuItem x:Name="MenuWin3600" Header="Show last 1 hour" IsCheckable="True" Click="WindowSecs_Click" Tag="3600"/>
                <MenuItem x:Name="MenuWin86400" Header="Show last 24 hours" IsCheckable="True" Click="WindowSecs_Click" Tag="86400"/>
                <Separator/>
                <MenuItem Header="Click cycles through">
                    <MenuItem x:Name="MenuCycleNet" Header="Net W" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Net"/>
                    <MenuItem x:Name="MenuCycleCpu" Header="CPU W" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Cpu"/>
                    <MenuItem x:Name="MenuCycleGpu" Header="iGPU W" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Gpu"/>
                    <MenuItem x:Name="MenuCycleWall" Header="Wall W" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Wall"/>
                    <MenuItem x:Name="MenuCyclePercent" Header="Battery %" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Percent"/>
                    <MenuItem x:Name="MenuCycleLoad" Header="Load %" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="Load"/>
                    <MenuItem x:Name="MenuCycleCpuTemp" Header="CPU °C" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="CpuTemp"/>
                    <MenuItem x:Name="MenuCycleDriveTemp" Header="Drive °C" IsCheckable="True" StaysOpenOnClick="True" Click="Cycle_Click" Tag="DriveTemp"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuAlwaysOnTop" Header="Always on top" IsCheckable="True" Click="AlwaysOnTop_Click"/>
                <MenuItem Header="Click-through (disable via tray icon menu)" Click="ClickThrough_Click"/>
                <MenuItem Header="Hide mini graph" Click="Hide_Click"/>
                <Separator/>
                <MenuItem Header="Exit PwrMon" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="MiniWatts" Text="— W" FontSize="24" FontWeight="Bold"
                           FontFamily="{DynamicResource NumeralFontFamily}" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextBrush}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="MiniSub" Text="" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Bottom" Margin="8,0,0,4" DockPanel.Dock="Left"/>
                <TextBlock x:Name="MiniPct" Text="" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="GraphArea" Grid.Column="0" ClipToBounds="True">
                    <Line x:Name="ZeroLine" Stroke="#333B49" StrokeThickness="1" StrokeDashArray="3 3"/>
                    <Polyline x:Name="Spark" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                </Grid>
                <!-- min/max of the visible window, so the line's shape has a scale to read against -->
                <TextBlock x:Name="MaxLabel" Grid.Column="1" Text="" FontSize="9" Margin="4,0,0,0"
                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <TextBlock x:Name="MinLabel" Grid.Column="1" Text="" FontSize="9" Margin="4,0,0,0"
                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>
    </Border>

    <!-- borderless + AllowsTransparency means Windows has no chrome to hit-test for
         edge-drag resize, so these invisible thumbs cover every edge and corner and drive
         Width/Height/Left/Top directly instead -->
    <Thumb x:Name="ResizeN" Height="6" VerticalAlignment="Top" Margin="8,0"
           Cursor="SizeNS" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeN_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeS" Height="6" VerticalAlignment="Bottom" Margin="8,0"
           Cursor="SizeNS" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeS_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeW" Width="6" HorizontalAlignment="Left" Margin="0,8"
           Cursor="SizeWE" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeW_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeE" Width="6" HorizontalAlignment="Right" Margin="0,8"
           Cursor="SizeWE" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeE_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeNW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
           Cursor="SizeNWSE" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeNW_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeNE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
           Cursor="SizeNESW" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeNE_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeSW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
           Cursor="SizeNESW" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeSW_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    <Thumb x:Name="ResizeSE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Cursor="SizeNWSE" Template="{StaticResource InvisibleThumb}"
           DragDelta="ResizeSE_DragDelta" DragCompleted="ResizeGrip_DragCompleted"/>
    </Grid>
</Window>
