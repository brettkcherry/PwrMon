<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PwrMon</RootNamespace>
    <AssemblyName>PwrMon</AssemblyName>
    <Version>1.5.0</Version>
    <Product>PwrMon</Product>
    <Authors>Brett Cherry</Authors>
    <Company>Brett Cherry</Company>
    <Copyright>© 2026 Brett Cherry</Copyright>
    <Description>Live power telemetry for Windows — battery flow, CPU/iGPU watts, history charts, tray wattage ticker.</Description>
    <!-- Public license. PwrMon is dual-licensed: GPL-3.0 here, with a separate commercial
         license available (COMMERCIAL-LICENSE.md) for anyone who needs to ship it inside a
         closed-source product. SPDX carries only the open half — that's the grant this
         binary is distributed under. -->
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/brettkcherry/PwrMon</RepositoryUrl>
    <PackageProjectUrl>https://brettkcherry.github.io/PwrMon/</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <!-- embedded PDBs put source paths in the binary, so logged stack traces would otherwise
         hand every user the build machine's directory layout. Normalise them. -->
    <PathMap>$(MSBuildProjectDirectory)=/PwrMon/</PathMap>
    <!-- Without this, PublishSingleFile still drops 11 native DLLs next to the exe
         (PresentationNative_cor3, wpfgfx_cor3, libSkiaSharp…). The app then runs only from
         the publish folder: copy the exe alone — as the installer did — and WPF throws
         DllNotFoundException in HwndSubclass the instant a window is created, which reads
         as "the app doesn't launch". Bundling them makes "portable exe" actually true. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon; keep its namespace out of implicit usings
         so WPF types (Application, Brush, RadioButton…) stay unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.9" />
    <PackageReference Include="System.Management" Version="10.0.9" />
    <!-- EventWaitHandleAcl: explicit DACLs on the cross-instance signals -->
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PwrMon.Tests" />
  </ItemGroup>

</Project>
